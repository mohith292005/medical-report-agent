# OpenRouter API Key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (must support tool calling, see https://openrouter.ai/models)
# Common options: anthropic/claude-sonnet-4.5, openai/gpt-4o, google/gemini-2.0-flash-001
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Optional Headers for OpenRouter analytics & ranking
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_TITLE="Medical Report Explanation Agent"

# Privacy / Safety settings
# When true, redacts detected patient names and IDs from saved trace files
TRACE_REDACT=true
